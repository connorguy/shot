# Gemini credentials: pick one.
#  - Application Default Credentials (for orgs that disallow API keys): run
#      gcloud auth application-default login
#    and leave GEMINI_API_KEY empty. The studio uses the ADC token with the Gemini Developer API and falls
#    back to Gemini Enterprise Agent Platform (Vertex) when the Developer API refuses it.
#  - An API key from AI Studio:
GEMINI_API_KEY=

# Optional: ElevenLabs as a second voice engine (Eleven v3, Multilingual v2, Flash v2.5). Pick it under
# Voiceover → Engine. Key from elevenlabs.io → Developers → API keys (text-to-speech + voices read).
ELEVENLABS_API_KEY=

# ADC options
# GOOGLE_CLOUD_PROJECT=your-project-id      # billing/quota project (default: ADC quota project, then gcloud config)
# GEMINI_BACKEND=auto                        # auto | developer | agent-platform
# GOOGLE_CLOUD_LOCATION=global               # Agent Platform location
# AP_TTS_MODEL=gemini-3.1-flash-tts-preview  # TTS model on Agent Platform (3.8 TTS isn't there yet)

# Optional: Chrome binary for thumbnails + export. Defaults to the installed Google Chrome.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Optional: where projects without an explicit location go (default: shot/projects).
# STUDIO_PROJECTS=/path/to/projects
# Optional: where the list of projects elsewhere on disk is kept (default: ~/.shot).
# STUDIO_HOME=~/.shot
